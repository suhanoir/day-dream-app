generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String
  email               String                @unique
  passwordHash        String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  emailVerified        Boolean               @default(false)
  notificationsEnabled Boolean               @default(true)
  notifyCalendar       Boolean               @default(true)
  notifyEmail          Boolean               @default(true)
  notifyOverdue        Boolean               @default(true)
  notifyTodo           Boolean               @default(true)
  notifyBucketList     Boolean               @default(true)
  notifyExpenses       Boolean               @default(true)
  notifyDaily          Boolean               @default(false)
  taskReminderTiming   String?               @default("due_time")
  eventReminderTiming  String?               @default("30_min_before")
  quietHoursEnabled    Boolean               @default(false)
  quietHoursStart      String?               @default("22:00")
  quietHoursEnd        String?               @default("07:00")
  timezone             String?               @default("UTC")
  bucketItems          BucketListItem[]
  categories           Category[]
  events               Event[]
  notifications        notifications[]
  todos                TodoTask[]
  verification_tokens  verification_tokens[]
  expenses             Expense[]
  pushSubscriptions    PushSubscription[]

  @@map("users")
}

model Category {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?          @default("emerald")
  icon        String?          @default("compass")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       BucketListItem[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model BucketListItem {
  id            String    @id @default(cuid())
  userId        String
  categoryId    String
  title         String
  description   String?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  reflection    String?
  memoryPhoto   String?
  memoryPhotos  String?
  postcardStyle String?   @default("polaroid")
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        Event[]

  @@index([userId])
  @@index([categoryId])
  @@map("bucket_list_items")
}

model Event {
  id               String          @id @default(cuid())
  userId           String
  bucketListItemId String?
  title            String
  description      String?
  date             DateTime
  startTime        String?
  endTime          String?
  location         String?
  category         String          @default("Personal")
  reminder         String?         @default("none")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bucketListItem   BucketListItem? @relation(fields: [bucketListItemId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications    notifications[]

  @@index([userId])
  @@index([date])
  @@index([bucketListItemId])
  @@map("events")
}

model TodoTask {
  id            String          @id @default(cuid())
  userId        String
  title         String
  description   String?
  date          DateTime
  completed     Boolean         @default(false)
  completedAt   DateTime?
  dueTime       String?
  priority      String          @default("Medium")
  category      String?         @default("Personal")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  reminder      String?         @default("none")
  notifications notifications[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("todo_tasks")
}

model notifications {
  id           String    @id @default(cuid())
  userId       String
  type         String
  title        String
  message      String
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("PENDING")
  todoTaskId   String?
  eventId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  events       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  todo_tasks   TodoTask? @relation(fields: [todoTaskId], references: [id], onDelete: Cascade)
  users        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([scheduledFor, status])
  @@index([todoTaskId])
  @@index([userId])
  @@map("notifications")
}

model verification_tokens {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("verification_tokens")
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  title     String
  amount    Float
  category  String   @default("Other")
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("expenses")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
