generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  categories   Category[]
  bucketItems  BucketListItem[]

  @@map("users")
}

model Category {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?          @default("emerald")
  icon        String?          @default("compass")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       BucketListItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model BucketListItem {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  reflection  String?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@map("bucket_list_items")
}

