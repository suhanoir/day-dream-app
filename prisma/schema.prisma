generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  categories   Category[]
  bucketItems  BucketListItem[]
  events       Event[]

  @@map("users")
}

model Category {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?          @default("emerald")
  icon        String?          @default("compass")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       BucketListItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model BucketListItem {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  reflection  String?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  events      Event[]

  @@index([userId])
  @@index([categoryId])
  @@map("bucket_list_items")
}

model Event {
  id               String          @id @default(cuid())
  userId           String
  bucketListItemId String?
  title            String
  description      String?
  date             DateTime
  startTime        String?
  endTime          String?
  location         String?
  category         String          @default("Personal")
  reminder         String?         @default("none")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketListItem   BucketListItem? @relation(fields: [bucketListItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([bucketListItemId])
  @@map("events")
}


